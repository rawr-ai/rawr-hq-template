{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "version": {
      "updateDependents": "never"
    },
    "groups": {
      "habitat-cli": {
        "projects": ["@habitat-ai/sdk", "@habitat-ai/cli"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "habitat-cli-v{version}"
        }
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**", "!{projectRoot}/coverage/**"],
    "production": [
      "default",
      "!{projectRoot}/test/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*"
    ],
    "habitatRuntime": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      {
        "env": "HABITAT_HARNESS_ROOT"
      },
      {
        "env": "HABITAT_CACHE_ROOT"
      },
      {
        "env": "HABITAT_PATTERN_CACHE_ROOT"
      },
      {
        "env": "HABITAT_TELEMETRY_DISABLED"
      },
      {
        "env": "HABITAT_COMMAND_TIMEOUT_MS"
      }
    ],
    "habitatCatalogAuthority": [
      "{workspaceRoot}/.habitat/**/*",
      "{workspaceRoot}/**/habitat.toml",
      "{workspaceRoot}/packages/habitat-sdk/package.json",
      "{workspaceRoot}/packages/habitat-sdk/habitat-pack.json"
    ],
    "typescriptRuntime": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/bun.lock"],
    "bunToolchain": ["{workspaceRoot}/package.json", "{workspaceRoot}/bun.lock"]
  },
  "plugins": ["@habitat-ai/cli/nx-plugin"],
  "targetDefaults": {
    "check": {
      "cache": false,
      "dependsOn": [
        {
          "projects": ["habitat"],
          "target": "lint"
        },
        "typecheck",
        "verify",
        "check:policy",
        "^check"
      ],
      "outputs": []
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "typescriptRuntime"],
      "outputs": ["{projectRoot}/dist"]
    },
    "manifest": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "bunToolchain",
        "typescriptRuntime",
        "!{projectRoot}/oclif.manifest.json"
      ],
      "outputs": ["{projectRoot}/oclif.manifest.json"]
    },
    "nx-release-publish": [
      {
        "dependsOn": ["..."]
      },
      {
        "filter": {
          "projects": ["@habitat-ai/cli", "@habitat-ai/sdk"]
        },
        "dependsOn": ["...", "build"]
      },
      {
        "filter": {
          "projects": ["@habitat-ai/cli", "@habitat-ai/sdk"]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@habitat-ai/cli"],
            "target": "acceptance:oclif-installed-package"
          }
        ]
      },
      {
        "filter": {
          "projects": ["@habitat-ai/cli"]
        },
        "dependsOn": ["...", "manifest"]
      }
    ],
    "typecheck": {
      "cache": true,
      "dependsOn": ["check:test", "check:tools", "^build"],
      "inputs": ["default", "^default", "typescriptRuntime"]
    },
    "check:test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "check:tools": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime", "{workspaceRoot}/vitest.config.ts"],
      "outputs": []
    },
    "verify": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    }
  }
}
