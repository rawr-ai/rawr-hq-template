#!/usr/bin/env sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
OLD_REF="${1:-}"
NEW_REF="${2:-}"
IS_BRANCH_SWITCH="${3:-0}"

if [ "${IS_BRANCH_SWITCH}" != "1" ]; then
  exit 0
fi

unset $(git rev-parse --local-env-vars)
if ! "${ROOT_DIR}/scripts/dev/auto-refresh-main.sh" "${OLD_REF}" "${NEW_REF}" "post-checkout"; then
  echo "[rawr-auto-refresh] warning: post-checkout dependency refresh failed; run bun install manually" >&2
fi
