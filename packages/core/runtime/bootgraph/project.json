{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "runtime-bootgraph",
  "root": "packages/core/runtime/bootgraph",
  "sourceRoot": "packages/core/runtime/bootgraph/src",
  "projectType": "library",
  "tags": ["type:runtime", "capability:habitat", "role:runtime-bootgraph"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx tsc -p packages/core/runtime/bootgraph/tsconfig.json --noEmit",
          "bunx tsc -p packages/core/runtime/bootgraph/tsconfig.test.json --noEmit"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "bun test packages/core/runtime/bootgraph/test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsdown --config packages/core/runtime/bootgraph/tsdown.config.ts"
      }
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
