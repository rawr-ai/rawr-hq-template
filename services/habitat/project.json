{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@habitat-ai/service",
  "targets": {
    "check": {
      "executor": "nx:noop"
    },
    "test": {
      "dependsOn": [
        "^build",
        {
          "projects": ["@habitat-ai/sdk"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^default",
        "typescriptRuntime",
        "{workspaceRoot}/vitest.config.ts",
        "habitatCatalogAuthority"
      ]
    }
  }
}
