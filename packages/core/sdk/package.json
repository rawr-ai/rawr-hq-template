{
  "name": "@habitat-ai/sdk",
  "version": "0.5.15",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "packages/core/sdk"
  },
  "description": "Habitat workspace client, runtime composition, and generic blueprints",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^24.18.1"
  },
  "files": [
    "dist",
    "habitat-pack.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js",
      "default": "./dist/app/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js",
      "default": "./dist/effect/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js",
      "default": "./dist/execution/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js",
      "default": "./dist/service/index.js"
    },
    "./service/schema": {
      "types": "./dist/service/schema.d.ts",
      "import": "./dist/service/schema.js",
      "default": "./dist/service/schema.js"
    },
    "./plugins/server": {
      "types": "./dist/plugins/server/index.d.ts",
      "import": "./dist/plugins/server/index.js",
      "default": "./dist/plugins/server/index.js"
    },
    "./plugins/server/effect": {
      "types": "./dist/plugins/server/effect/index.d.ts",
      "import": "./dist/plugins/server/effect/index.js",
      "default": "./dist/plugins/server/effect/index.js"
    },
    "./plugins/async": {
      "types": "./dist/plugins/async/index.d.ts",
      "import": "./dist/plugins/async/index.js",
      "default": "./dist/plugins/async/index.js"
    },
    "./plugins/async/effect": {
      "types": "./dist/plugins/async/effect/index.d.ts",
      "import": "./dist/plugins/async/effect/index.js",
      "default": "./dist/plugins/async/effect/index.js"
    },
    "./plugins/web": {
      "types": "./dist/plugins/web/index.d.ts",
      "import": "./dist/plugins/web/index.js",
      "default": "./dist/plugins/web/index.js"
    },
    "./runtime/resources": {
      "types": "./dist/runtime/resources/index.d.ts",
      "import": "./dist/runtime/resources/index.js",
      "default": "./dist/runtime/resources/index.js"
    },
    "./runtime/providers": {
      "types": "./dist/runtime/providers/index.d.ts",
      "import": "./dist/runtime/providers/index.js",
      "default": "./dist/runtime/providers/index.js"
    },
    "./runtime/profiles": {
      "types": "./dist/runtime/profiles/index.d.ts",
      "import": "./dist/runtime/profiles/index.js",
      "default": "./dist/runtime/profiles/index.js"
    },
    "./runtime/derivation": {
      "types": "./dist/runtime/derivation/index.d.ts",
      "import": "./dist/runtime/derivation/index.js",
      "default": "./dist/runtime/derivation/index.js"
    },
    "./runtime/schema": {
      "types": "./dist/runtime/schema.d.ts",
      "import": "./dist/runtime/schema.js",
      "default": "./dist/runtime/schema.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js",
      "default": "./dist/telemetry.js"
    },
    "./habitat-pack.json": "./habitat-pack.json",
    "./blueprints/*": "./dist/blueprints/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project habitat-sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/platform-node-shared": "4.0.0-beta.101",
    "@getgrit/cli": "0.1.0-alpha.1743007075",
    "@opentelemetry/api": "1.9.0",
    "@orpc/contract": "2.0.0-beta.23",
    "@orpc/experimental-effect": "2.0.0-beta.23",
    "@orpc/server": "2.0.0-beta.23",
    "@standard-schema/spec": "1.1.0",
    "effect": "4.0.0-beta.101",
    "picomatch": "4.0.4",
    "smol-toml": "1.7.0",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/picomatch": "4.0.3",
    "typescript": "^5.9.3"
  },
  "nx": {
    "tags": [
      "type:package",
      "npm:public",
      "capability:habitat",
      "role:sdk"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
