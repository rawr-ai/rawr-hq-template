{
  "name": "@rawr/server",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.7",
  "exports": {
    "./host": {
      "types": "./src/host.ts",
      "default": "./src/host.ts"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@orpc/client": "2.0.0-beta.20",
    "@orpc/contract": "2.0.0-beta.20",
    "@orpc/json-schema": "2.0.0-beta.20",
    "@orpc/openapi": "2.0.0-beta.20",
    "@orpc/server": "2.0.0-beta.20",
    "@habitat-ai/rawr-core": "workspace:*",
    "@rawr/example-todo": "workspace:*",
    "@habitat-ai/rawr-hq-ops": "workspace:*",
    "@habitat-ai/rawr-hq-sdk": "workspace:*",
    "@rawr/runtime-context": "workspace:*",
    "elysia": "^1.3.12",
    "inngest": "3.51.0",
    "pino": "^10.3.1",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@types/node": "^22.14.0",
    "inngest-cli": "1.16.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev:inngest": "env npm_config_ignore_scripts=false npm exec --yes --package=inngest-cli@1.16.1 -- inngest dev -u http://localhost:3000/api/inngest",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project server",
    "orpc:openapi:write": "bun scripts/write-orpc-openapi.ts",
    "orpc:openapi:types": "bunx openapi-typescript ./openapi/orpc-openapi.json -o ./openapi/orpc-openapi.types.ts",
    "orpc:openapi:sdk": "bun run orpc:openapi:write && bun run orpc:openapi:types"
  },
  "nx": {
    "implicitDependencies": [
      "plugin-server-api-example-todo"
    ],
    "tags": [
      "type:app",
      "app:hq",
      "role:server",
      "migration-slice:structural-tranche"
    ]
  }
}
