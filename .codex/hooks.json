{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/tools/workstream-plugin-pack/hooks/workstream_startup.ts\"",
            "timeout": 5,
            "statusMessage": "Loading workstream startup context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/tools/workstream-plugin-pack/hooks/workstream_closure_guard.ts\"",
            "timeout": 10,
            "statusMessage": "Checking workstream mechanical guardrails"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'repo=\"${CODEX_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-}}\"; if [ -n \"$repo\" ]; then repo=\"$(git -C \"$repo\" rev-parse --show-toplevel 2>/dev/null)\"; else repo=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; fi && cd \"$repo\" 2>/dev/null || { printf \"%s\\n\" \"Habitat agent-stop hook must run inside the repository worktree.\" >&2; exit 2; }; bun habitat hook agent-stop'",
            "timeout": 120,
            "statusMessage": "Checking Habitat structure laws"
          }
        ]
      }
    ]
  }
}
