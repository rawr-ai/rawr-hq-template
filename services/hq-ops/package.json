{
  "name": "@habitat-ai/rawr-hq-ops",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "services/hq-ops"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#hq-ops-service/*": "./src/service/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./service/contract": {
      "types": "./src/service/contract.ts",
      "default": "./src/service/contract.ts"
    },
    "./migrations/0001_journal.sql": {
      "default": "./src/service/db/migrations/0001_journal.sql"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project hq-ops"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@orpc/contract": "2.0.0-beta.23",
    "@orpc/server": "2.0.0-beta.23",
    "@habitat-ai/rawr-hq-sdk": "workspace:*",
    "@habitat-ai/typebox-adapter": "workspace:*",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@types/bun": "^1.2.10",
    "typescript": "^5.9.3"
  },
  "nx": {
    "tags": [
      "type:service",
      "role:servicepackage",
      "migration-slice:structural-tranche"
    ]
  }
}
