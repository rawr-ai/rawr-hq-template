PREFIX workbench: <urn:semantica-workbench:ontology:>
PREFIX evidence: <urn:semantica-workbench:evidence:>

# Aggregate-only target pressure query. Use named evidence queries for source
# spans and review actions before making reviewer decisions.
SELECT ?target (COUNT(?finding) AS ?findingCount) WHERE {
  ?finding a workbench:ReviewFinding ;
    workbench:partOfEvidenceIndex ?evidenceIndex ;
    workbench:resolvedTarget ?target .
}
GROUP BY ?target
ORDER BY DESC(?findingCount) ?target
