{
  "name": "@habitat-ai/rawr-hyperresearch-codex",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "services/hyperresearch-codex"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    },
    "./resources": {
      "types": "./src/service/common/resources.ts",
      "default": "./src/service/common/resources.ts"
    },
    "./service/contract": {
      "types": "./src/service/contract.ts",
      "default": "./src/service/contract.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project hyperresearch-codex"
  },
  "dependencies": {
    "@orpc/contract": "2.0.0-beta.20",
    "@orpc/server": "2.0.0-beta.20",
    "@habitat-ai/rawr-hq-sdk": "workspace:*",
    "@habitat-ai/typebox-adapter": "0.1.1",
    "typebox": "1.3.8"
  },
  "devDependencies": {
