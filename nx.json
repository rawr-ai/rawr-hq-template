{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "version": {
      "updateDependents": "never"
    },
    "groups": {
      "rawr-cli": {
        "projects": [
          "@habitat-ai/rawr-agent-plugin-lifecycle",
          "@habitat-ai/rawr-chatgpt-corpus",
          "@habitat-ai/rawr",
          "@habitat-ai/rawr-core",
          "@habitat-ai/rawr-dev",
          "@habitat-ai/rawr-dev-node",
          "@habitat-ai/rawr-hq-ops",
          "@habitat-ai/rawr-hq-sdk",
          "@habitat-ai/rawr-hyperresearch-codex",
          "@habitat-ai/rawr-plugin-chatgpt-corpus",
          "@habitat-ai/rawr-plugin-devops",
          "@habitat-ai/rawr-plugin-hyperresearch",
          "@habitat-ai/rawr-plugin-session-tools",
          "@habitat-ai/rawr-resource-agent-plugin-package-output",
          "@habitat-ai/rawr-resource-content-workspace",
          "@habitat-ai/rawr-resource-native-agent-provider",
          "@habitat-ai/rawr-resource-versioned-content",
          "@habitat-ai/rawr-session-intelligence"
        ],
        "projectsRelationship": "fixed"
      },
      "habitat-cli": {
        "projects": [
          "@habitat-ai/cli",
          "@habitat-ai/plugin-cli",
          "@habitat-ai/resource-rule-evaluation",
          "@habitat-ai/resource-source-inventory",
          "@habitat-ai/service"
        ],
        "projectsRelationship": "fixed",
        "version": {
          "preserveLocalDependencyProtocols": true
        },
        "releaseTag": {
          "pattern": "habitat-cli-v{version}"
        }
      },
      "habitat-blueprints": {
        "projects": ["@habitat-ai/blueprints"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "habitat-blueprints-v{version}"
        }
      },
      "typebox-adapter": {
        "projects": ["@habitat-ai/typebox-adapter"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "typebox-adapter-v{version}"
        }
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**", "!{projectRoot}/coverage/**"],
    "production": [
      "default",
      "!{projectRoot}/test/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*"
    ],
    "habitatRuntime": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      {
        "env": "HABITAT_HARNESS_ROOT"
      },
      {
        "env": "HABITAT_CACHE_ROOT"
      },
      {
        "env": "HABITAT_PATTERN_CACHE_ROOT"
      },
      {
        "env": "HABITAT_TELEMETRY_DISABLED"
      },
      {
        "env": "HABITAT_COMMAND_TIMEOUT_MS"
      }
    ],
    "habitatCatalogAuthority": [
      "{workspaceRoot}/.habitat/**/*",
      "{workspaceRoot}/**/habitat.toml",
      "{workspaceRoot}/packages/habitat-blueprints/package.json",
      "{workspaceRoot}/packages/habitat-blueprints/habitat-pack.json"
    ],
    "typescriptRuntime": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/bun.lock"],
    "bunToolchain": ["{workspaceRoot}/package.json", "{workspaceRoot}/bun.lock"]
  },
  "plugins": ["@habitat-ai/cli/nx-plugin"],
  "targetDefaults": {
    "check": {
      "cache": false,
      "dependsOn": [
        {
          "projects": ["habitat"],
          "target": "lint"
        },
        "typecheck",
        "verify",
        "check:policy",
        "^check"
      ],
      "outputs": []
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "typescriptRuntime"],
      "outputs": ["{projectRoot}/dist"]
    },
    "manifest": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "bunToolchain",
        "typescriptRuntime",
        "!{projectRoot}/oclif.manifest.json"
      ],
      "outputs": ["{projectRoot}/oclif.manifest.json"]
    },
    "nx-release-publish": [
      {
        "dependsOn": ["..."]
      },
      {
        "filter": {
          "projects": [
            "@habitat-ai/cli",
            "@habitat-ai/plugin-cli",
            "@habitat-ai/resource-rule-evaluation",
            "@habitat-ai/resource-source-inventory",
            "@habitat-ai/service",
            "@habitat-ai/rawr-agent-plugin-lifecycle",
            "@habitat-ai/rawr-chatgpt-corpus",
            "@habitat-ai/rawr",
            "@habitat-ai/rawr-core",
            "@habitat-ai/rawr-dev",
            "@habitat-ai/rawr-dev-node",
            "@habitat-ai/rawr-hq-ops",
            "@habitat-ai/rawr-hq-sdk",
            "@habitat-ai/rawr-hyperresearch-codex",
            "@habitat-ai/rawr-plugin-chatgpt-corpus",
            "@habitat-ai/rawr-plugin-devops",
            "@habitat-ai/rawr-plugin-hyperresearch",
            "@habitat-ai/rawr-plugin-session-tools",
            "@habitat-ai/rawr-resource-agent-plugin-package-output",
            "@habitat-ai/rawr-resource-content-workspace",
            "@habitat-ai/rawr-resource-native-agent-provider",
            "@habitat-ai/rawr-resource-versioned-content",
            "@habitat-ai/rawr-session-intelligence",
            "@habitat-ai/typebox-adapter"
          ]
        },
        "dependsOn": ["...", "build"]
      },
      {
        "filter": {
          "projects": [
            "@habitat-ai/rawr-agent-plugin-lifecycle",
            "@habitat-ai/rawr-chatgpt-corpus",
            "@habitat-ai/rawr",
            "@habitat-ai/rawr-core",
            "@habitat-ai/rawr-dev",
            "@habitat-ai/rawr-dev-node",
            "@habitat-ai/rawr-hq-ops",
            "@habitat-ai/rawr-hq-sdk",
            "@habitat-ai/rawr-hyperresearch-codex",
            "@habitat-ai/rawr-plugin-chatgpt-corpus",
            "@habitat-ai/rawr-plugin-devops",
            "@habitat-ai/rawr-plugin-hyperresearch",
            "@habitat-ai/rawr-plugin-session-tools",
            "@habitat-ai/rawr-resource-agent-plugin-package-output",
            "@habitat-ai/rawr-resource-content-workspace",
            "@habitat-ai/rawr-resource-native-agent-provider",
            "@habitat-ai/rawr-resource-versioned-content",
            "@habitat-ai/rawr-session-intelligence"
          ]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@habitat-ai/rawr"],
            "target": "acceptance:oclif-installed-package"
          },
          {
            "projects": ["@habitat-ai/rawr"],
            "target": "acceptance:oclif-native-plugins"
          }
        ]
      },
      {
        "filter": {
          "projects": [
            "@habitat-ai/rawr",
            "@habitat-ai/rawr-plugin-chatgpt-corpus",
            "@habitat-ai/rawr-plugin-devops",
            "@habitat-ai/rawr-plugin-hyperresearch",
            "@habitat-ai/rawr-plugin-session-tools"
          ]
        },
        "dependsOn": ["...", "manifest"]
      },
      {
        "filter": {
          "projects": [
            "@habitat-ai/cli",
            "@habitat-ai/plugin-cli",
            "@habitat-ai/resource-rule-evaluation",
            "@habitat-ai/resource-source-inventory",
            "@habitat-ai/service"
          ]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@habitat-ai/cli"],
            "target": "acceptance:oclif-installed-package"
          }
        ]
      },
      {
        "filter": {
          "projects": ["@habitat-ai/cli", "@habitat-ai/plugin-cli"]
        },
        "dependsOn": ["...", "manifest"]
      }
    ],
    "typecheck": {
      "cache": true,
      "dependsOn": ["check:test", "check:tools", "^build"],
      "inputs": ["default", "^default", "typescriptRuntime"]
    },
    "check:test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "check:tools": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime", "{workspaceRoot}/vitest.config.ts"],
      "outputs": []
    },
    "verify": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    }
  }
}
