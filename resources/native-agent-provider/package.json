{
  "name": "@habitat-ai/resource-native-agent-provider",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "resources/native-agent-provider"
  },
  "files": [
    "dist",
    "contract.ts",
    "runtime.ts",
    "providers/effect-platform-node-shared.ts",
    "providers/codex-effect-platform-node/index.ts",
    "providers/codex-effect-platform-node/runtime.ts",
    "providers/claude-effect-platform-node/index.ts",
    "providers/claude-effect-platform-node/runtime.ts"
  ],
  "type": "module",
  "imports": {
    "#native-agent-provider-effect-platform-node": "./providers/effect-platform-node-shared.ts"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./providers/codex-effect-platform-node/runtime": {
      "types": "./dist/providers/codex-effect-platform-node/runtime.d.ts",
      "default": "./dist/providers/codex-effect-platform-node/runtime.js"
    },
    "./providers/claude-effect-platform-node/runtime": {
      "types": "./dist/providers/claude-effect-platform-node/runtime.d.ts",
      "default": "./dist/providers/claude-effect-platform-node/runtime.js"
    },
    ".": {
      "types": "./contract.ts",
      "default": "./contract.ts"
    },
    "./providers/codex-effect-platform-node": {
      "types": "./providers/codex-effect-platform-node/index.ts",
      "default": "./providers/codex-effect-platform-node/index.ts"
    },
    "./providers/claude-effect-platform-node": {
      "types": "./providers/claude-effect-platform-node/index.ts",
      "default": "./providers/claude-effect-platform-node/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test providers/contract.test.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@habitat-ai/sdk": "workspace:*",
    "@effect/platform-node": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "nx": {
    "tags": [
      "type:resource",
      "layer:resource-contract",
      "resource:native-agent-provider"
    ]
  }
}
