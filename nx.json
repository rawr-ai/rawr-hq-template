{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "groups": {
      "rawr-cli": {
        "projects": [
          "@rawr/agent-plugin-lifecycle",
          "@rawr/chatgpt-corpus",
          "@rawr/cli",
          "@rawr/core",
          "@rawr/dev",
          "@rawr/dev-node",
          "@rawr/hq-ops",
          "@rawr/hq-sdk",
          "@rawr/hyperresearch-codex",
          "@rawr/plugin-chatgpt-corpus",
          "@rawr/plugin-devops",
          "@rawr/plugin-hyperresearch",
          "@rawr/plugin-session-tools",
          "@rawr/resource-agent-plugin-package-output",
          "@rawr/resource-content-workspace",
          "@rawr/resource-native-agent-provider",
          "@rawr/resource-versioned-content",
          "@rawr/session-intelligence",
          "@rawr/typebox-adapter"
        ],
        "projectsRelationship": "fixed"
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**", "!{projectRoot}/coverage/**"],
    "production": [
      "default",
      "!{projectRoot}/test/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*"
    ],
    "habitatPolicy": ["{workspaceRoot}/.habitat/**/*", "!{workspaceRoot}/.habitat/cache/**"],
    "habitatTypecheckSources": [
      "{workspaceRoot}/.habitat/blueprints/nx-workspace/require_nx_project_quality_targets/check.mjs",
      "{workspaceRoot}/.habitat/blueprints/typescript-source/require_imported_exports_have_jsdoc/check.mjs"
    ],
    "typescriptRuntime": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/bun.lock"],
    "bunToolchain": ["{workspaceRoot}/package.json", "{workspaceRoot}/bun.lock"]
  },
  "targetDefaults": {
    "check": {
      "cache": false,
      "dependsOn": [
        {
          "projects": ["habitat"],
          "target": "lint"
        },
        "typecheck",
        "verify",
        "check:policy",
        "^check"
      ],
      "outputs": []
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "typescriptRuntime"],
      "outputs": ["{projectRoot}/dist"]
    },
    "manifest": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "bunToolchain",
        "typescriptRuntime",
        "!{projectRoot}/oclif.manifest.json"
      ],
      "outputs": ["{projectRoot}/oclif.manifest.json"]
    },
    "nx-release-publish": {
      "dependsOn": ["build", "manifest"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["check:test", "check:tools", "^build"],
      "inputs": ["default", "^default", "typescriptRuntime"]
    },
    "check:test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "check:tools": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime", "{workspaceRoot}/vitest.config.ts"],
      "outputs": []
    },
    "verify": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    }
  }
}
