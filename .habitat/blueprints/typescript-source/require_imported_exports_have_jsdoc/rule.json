{
  "schemaVersion": 2,
  "id": "require_imported_exports_have_jsdoc",
  "title": "Require Imported Exports To Have JSDoc",
  "placement": {
    "niche": "rawr",
    "blueprint": "typescript-source",
    "category": "quality"
  },
  "operation": {
    "kind": "check"
  },
  "ownerProject": "habitat",
  "lane": "enforced",
  "forbids": "an authored JavaScript or TypeScript symbol consumed from another production source file without declaration-site non-placeholder JSDoc, or a consumed value-callable export with more than three parameters whose actual parameter declarations lack descriptive @param tags",
  "why": "A symbol that crosses a source-file boundary becomes part of another owner's working context. Declaration-site JSDoc keeps its purpose, ownership, behavior, and flow visible at that boundary without requiring ceremonial comments on local-only exports.",
  "remediate": "Document the consumed symbol at its owning declaration, explaining what it owns or does, why it exists, and how it participates in module or system behavior. For a value-callable export with more than three parameters, add a descriptive @param tag for every actual parameter name. Remove an unnecessary export or import rather than documenting a boundary that should not exist.",
  "message": "Cross-file JavaScript and TypeScript exports require useful declaration-site JSDoc and complete @param tags for value-callable exports with more than three parameters.",
  "pathCoverage": [
    {
      "kind": "exact-path",
      "patterns": [
        "bun.lock",
        "nx.json",
        "package.json",
        "scripts/habitat/project.json",
        "tsconfig.base.json",
        "apps/**/package.json",
        "apps/**/tsconfig.json",
        "apps/**/*.cjs",
        "apps/**/*.cts",
        "apps/**/*.js",
        "apps/**/*.jsx",
