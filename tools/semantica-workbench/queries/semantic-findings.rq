PREFIX workbench: <urn:semantica-workbench:ontology:>
PREFIX evidence: <urn:semantica-workbench:evidence:>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?finding ?kind ?claim ?target ?rule WHERE {
  ?finding a workbench:ReviewFinding ;
    workbench:findingKind ?kind ;
    workbench:derivedFrom ?claim ;
    workbench:rule ?rule .
  OPTIONAL { ?finding workbench:resolvedTarget ?target . }
}
ORDER BY ?kind ?finding
