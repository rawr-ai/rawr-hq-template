{
  "name": "@habitat/cli",
  "version": "0.2.0",
  "private": false,
  "description": "Habitat structural authority CLI and Nx projection",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^20.19.0 || >=22.9.0"
  },
  "files": [
    "bin",
    "dist",
    "src/nx-plugin.d.ts",
    "oclif.manifest.json",
    "package.json"
  ],
  "bin": {
    "habitat": "./bin/run.js"
  },
  "exports": {
    "./nx-plugin": {
      "types": "./src/nx-plugin.d.ts",
      "import": "./dist/nx-plugin.js",
      "default": "./dist/nx-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "habitat": "bun src/index.ts",
    "build": "tsc -p src/tsconfig.build.json && bun build src/nx-plugin.ts --outdir dist --target node --format esm",
    "manifest": "NODE_ENV=production bun --bun oclif manifest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run --project habitat-cli"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@getgrit/cli": "0.1.0-alpha.1743007075",
    "@habitat/plugin-cli": "0.1.0",
    "@habitat/resource-rule-evaluation": "0.1.0",
    "@habitat/resource-source-inventory": "0.1.0",
    "@habitat/service": "0.1.0",
    "@nx/devkit": "23.1.0",
    "@oclif/core": "^4.11.4",
    "@oclif/plugin-help": "^6.2.27",
    "effect": "4.0.0-beta.101",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "bun-types": "1.3.14",
    "oclif": "4.23.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "oclif": {
    "bin": "habitat",
    "dirname": "habitat",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@habitat/plugin-cli"
    ]
  },
  "nx": {
    "tags": [
      "type:app",
      "app:habitat",
      "role:cli"
    ],
    "targets": {
      "manifest": {
        "dependsOn": [
          "build",
          {
            "projects": [
              "@habitat/plugin-cli"
            ],
            "target": "manifest"
          }
        ]
      },
      "test": {
        "dependsOn": [
          "build",
          "manifest"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
