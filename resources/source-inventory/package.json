      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./providers/git-effect-platform-node/runtime": {
      "types": "./dist/providers/git-effect-platform-node/runtime.d.ts",
      "default": "./dist/providers/git-effect-platform-node/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test test/contract.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101",
    "typebox": "1.3.8",
    "@habitat-ai/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "bun-types": "1.3.14"
