{
  "name": "@habitat-ai/resource-source-inventory",
  "version": "0.3.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "resources/source-inventory"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/contract.js",
  "types": "./dist/contract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./providers/git-effect-platform-node": {
      "types": "./dist/providers/git-effect-platform-node/index.d.ts",
