{
  "name": "@rawr/plugin-hello",
  "version": "0.1.0",
  "private": true,
  "description": "RAWR HQ-Template sample oclif plugin",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "oclif.manifest.json",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@oclif/core": "^4.13.2"
  },
  "oclif": {
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "typescript": {
      "commands": "./src/commands"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oclif": "4.23.29",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "manifest": "NODE_ENV=production bun --bun oclif manifest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --project plugin-hello"
  },
  "nx": {
    "tags": [
      "type:plugin"
    ]
  }
}
