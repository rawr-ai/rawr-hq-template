{
  "name": "@rawr/hq-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./rawr.hq.ts",
      "default": "./rawr.hq.ts"
    }
  },
  "dependencies": {
    "@habitat-ai/resource-telemetry": "workspace:*",
    "@orpc/contract": "2.0.0-beta.23",
    "@orpc/server": "2.0.0-beta.23",
    "@rawr/example-todo": "workspace:*",
    "@habitat-ai/rawr-hq-sdk": "workspace:*",
    "@rawr/runtime-context": "workspace:*",
    "@rawr/server": "workspace:*",
    "inngest": "3.51.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun --hot dev.ts",
    "dev:server": "bun --hot server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bunx vitest run --project hq-app"
  },
  "nx": {
    "implicitDependencies": [
      "plugin-server-api-example-todo"
    ],
    "tags": [
      "type:app",
      "app:hq",
      "migration-slice:structural-tranche"
    ]
  }
}
