{
  "name": "@habitat-ai/dev-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "services/dev"
  },
  "files": [
    "src"
  ],
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun --bun vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@habitat-ai/resource-child-process": "workspace:*",
    "@habitat-ai/resource-filesystem": "workspace:*",
    "@habitat-ai/sdk": "workspace:*",
    "@orpc/contract": "2.0.0-beta.32",
    "@orpc/server": "2.0.0-beta.32",
    "effect": "4.0.0-beta.101",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@orpc/experimental-effect": "2.0.0-beta.32",
    "@types/bun": "^1.2.10",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "nx": {
    "tags": [
      "type:service",
      "role:servicepackage"
    ]
  }
}
