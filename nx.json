{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "version": {
      "updateDependents": "never"
    },
    "groups": {
      "rawr-cli": {
        "projects": [
          "@rawr/agent-plugin-lifecycle",
          "@rawr/chatgpt-corpus",
          "@rawr/cli",
          "@rawr/core",
          "@rawr/dev",
          "@rawr/dev-node",
          "@rawr/hq-ops",
          "@rawr/hq-sdk",
          "@rawr/hyperresearch-codex",
          "@rawr/plugin-chatgpt-corpus",
          "@rawr/plugin-devops",
          "@rawr/plugin-hyperresearch",
          "@rawr/plugin-session-tools",
          "@rawr/resource-agent-plugin-package-output",
          "@rawr/resource-content-workspace",
          "@rawr/resource-native-agent-provider",
          "@rawr/resource-versioned-content",
          "@rawr/session-intelligence"
        ],
        "projectsRelationship": "fixed"
      },
      "habitat-cli": {
        "projects": [
          "@habitat-ai/cli",
          "@habitat-ai/plugin-cli",
          "@habitat-ai/resource-rule-evaluation",
          "@habitat-ai/resource-source-inventory",
          "@habitat-ai/service"
        ],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "habitat-cli-v{version}"
        }
      },
      "habitat-blueprints": {
        "projects": ["@habitat-ai/blueprints"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "habitat-blueprints-v{version}"
        }
      },
      "typebox-adapter": {
        "projects": ["@rawr/typebox-adapter"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "typebox-adapter-v{version}"
        }
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**", "!{projectRoot}/coverage/**"],
    "production": [
      "default",
      "!{projectRoot}/test/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*"
    ],
    "habitatRuntime": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      { "env": "HABITAT_HARNESS_ROOT" },
      { "env": "HABITAT_CACHE_ROOT" },
      { "env": "HABITAT_PATTERN_CACHE_ROOT" },
      { "env": "HABITAT_TELEMETRY_DISABLED" },
      { "env": "HABITAT_COMMAND_TIMEOUT_MS" }
    ],
    "typescriptRuntime": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/bun.lock"],
    "bunToolchain": ["{workspaceRoot}/package.json", "{workspaceRoot}/bun.lock"]
  },
  "plugins": [
    {
      "plugin": "@habitat/cli/nx-plugin",
      "options": {
        "checkTargetName": "check:policy"
      }
    }
  ],
  "targetDefaults": {
    "check": {
      "cache": false,
      "dependsOn": [
        {
          "projects": ["habitat"],
          "target": "lint"
        },
        "typecheck",
        "verify",
        "check:policy",
        "^check"
      ],
      "outputs": []
    },
    "check:policy:local": [
      {
        "filter": {
          "plugin": "@habitat/cli/nx-plugin",
          "projects": ["@rawr/agent-plugin-lifecycle"]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["habitat"],
            "target": "check:policy:local"
          }
        ]
      },
      {
        "filter": {
          "plugin": "@habitat/cli/nx-plugin",
          "projects": ["@rawr/hq-app"]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@rawr/agent-plugin-lifecycle"],
            "target": "check:policy:local"
          }
        ]
      },
      {
        "filter": {
          "plugin": "@habitat/cli/nx-plugin",
          "projects": ["@rawr/web"]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@rawr/hq-app"],
            "target": "check:policy:local"
          }
        ]
      },
      {
        "filter": {
          "plugin": "@habitat/cli/nx-plugin",
          "projects": ["runtime-realization-type-env"]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@rawr/web"],
            "target": "check:policy:local"
          }
        ]
      },
      {
        "filter": {
          "plugin": "@habitat/cli/nx-plugin",
          "projects": ["workstream-plugin-pack"]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["runtime-realization-type-env"],
            "target": "check:policy:local"
          }
        ]
      }
    ],
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "typescriptRuntime"],
      "outputs": ["{projectRoot}/dist"]
    },
    "manifest": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "bunToolchain",
        "typescriptRuntime",
        "!{projectRoot}/oclif.manifest.json"
      ],
      "outputs": ["{projectRoot}/oclif.manifest.json"]
    },
    "nx-release-publish": [
      {
        "dependsOn": ["..."]
      },
      {
        "filter": {
          "projects": [
            "@habitat-ai/cli",
            "@habitat-ai/plugin-cli",
            "@habitat-ai/resource-rule-evaluation",
            "@habitat-ai/resource-source-inventory",
            "@habitat-ai/service",
            "@rawr/agent-plugin-lifecycle",
            "@rawr/chatgpt-corpus",
            "@rawr/cli",
            "@rawr/core",
            "@rawr/dev",
            "@rawr/dev-node",
            "@rawr/hq-ops",
            "@rawr/hq-sdk",
            "@rawr/hyperresearch-codex",
            "@rawr/plugin-chatgpt-corpus",
            "@rawr/plugin-devops",
            "@rawr/plugin-hyperresearch",
            "@rawr/plugin-session-tools",
            "@rawr/resource-agent-plugin-package-output",
            "@rawr/resource-content-workspace",
            "@rawr/resource-native-agent-provider",
            "@rawr/resource-versioned-content",
            "@rawr/session-intelligence",
            "@rawr/typebox-adapter"
          ]
        },
        "dependsOn": ["...", "build"]
      },
      {
        "filter": {
          "projects": [
            "@rawr/agent-plugin-lifecycle",
            "@rawr/chatgpt-corpus",
            "@rawr/cli",
            "@rawr/core",
            "@rawr/dev",
            "@rawr/dev-node",
            "@rawr/hq-ops",
            "@rawr/hq-sdk",
            "@rawr/hyperresearch-codex",
            "@rawr/plugin-chatgpt-corpus",
            "@rawr/plugin-devops",
            "@rawr/plugin-hyperresearch",
            "@rawr/plugin-session-tools",
            "@rawr/resource-agent-plugin-package-output",
            "@rawr/resource-content-workspace",
            "@rawr/resource-native-agent-provider",
            "@rawr/resource-versioned-content",
            "@rawr/session-intelligence"
          ]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@rawr/cli"],
            "target": "acceptance:oclif-installed-package"
          },
          {
            "projects": ["@rawr/cli"],
            "target": "acceptance:oclif-native-plugins"
          }
        ]
      },
      {
        "filter": {
          "projects": [
            "@rawr/cli",
            "@rawr/plugin-chatgpt-corpus",
            "@rawr/plugin-devops",
            "@rawr/plugin-hyperresearch",
            "@rawr/plugin-session-tools"
          ]
        },
        "dependsOn": ["...", "manifest"]
      },
      {
        "filter": {
          "projects": [
            "@habitat-ai/cli",
            "@habitat-ai/plugin-cli",
            "@habitat-ai/resource-rule-evaluation",
            "@habitat-ai/resource-source-inventory",
            "@habitat-ai/service"
          ]
        },
        "dependsOn": [
          "...",
          {
            "projects": ["@habitat-ai/cli"],
            "target": "acceptance:oclif-installed-package"
          }
        ]
      },
      {
        "filter": {
          "projects": ["@habitat-ai/cli", "@habitat-ai/plugin-cli"]
        },
        "dependsOn": ["...", "manifest"]
      }
    ],
    "typecheck": {
      "cache": true,
      "dependsOn": ["check:test", "check:tools", "^build"],
      "inputs": ["default", "^default", "typescriptRuntime"]
    },
    "check:test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "check:tools": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "typescriptRuntime", "{workspaceRoot}/vitest.config.ts"],
      "outputs": []
    },
    "verify": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    }
  }
}
