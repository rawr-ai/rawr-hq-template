{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "runtime-harnesses",
  "root": "packages/core/runtime/harnesses",
  "sourceRoot": "packages/core/runtime/harnesses/src",
  "projectType": "library",
  "tags": ["type:runtime", "capability:habitat", "role:runtime-harnesses"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx tsc -p packages/core/runtime/harnesses/tsconfig.json --noEmit",
          "bunx tsc -p packages/core/runtime/harnesses/tsconfig.test.json --noEmit"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": [
        "^build",
        "acceptance:server-native-telemetry",
        "acceptance:async-native-telemetry",
        "acceptance:process-isolation",
        "acceptance:workflow-admission",
        "acceptance:web"
      ],
      "options": { "command": "bun test packages/core/runtime/harnesses/test" }
    },
    "acceptance:server": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build", { "projects": ["@habitat-ai/sdk"], "target": "build" }],
      "options": {
        "command": "bun packages/core/sdk/test/fixtures/server-runtime.ts"
      }
    },
    "acceptance:server-native-telemetry": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build", { "projects": ["@habitat-ai/sdk"], "target": "build" }],
      "options": {
        "command": "bun packages/core/sdk/test/fixtures/server-runtime.ts"
      }
    },
    "acceptance:async-native-telemetry": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build", { "projects": ["@habitat-ai/sdk"], "target": "build" }],
      "options": {
        "command": "bun packages/core/sdk/test/fixtures/async-runtime.ts"
      }
    },
    "acceptance:process-isolation": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build", { "projects": ["@habitat-ai/sdk"], "target": "build" }],
      "options": {
        "command": "bun packages/core/sdk/test/fixtures/process-isolation.ts"
      }
    },
    "acceptance:workflow-admission": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build", { "projects": ["@habitat-ai/sdk"], "target": "build" }],
      "options": {
        "command": "bun packages/core/sdk/test/fixtures/workflow-admission.ts"
      }
    },
    "acceptance:web": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build", { "projects": ["@habitat-ai/sdk"], "target": "build" }],
      "options": {
        "command": "bun packages/core/sdk/test/fixtures/web-runtime.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsdown --config packages/core/runtime/harnesses/tsdown.config.ts"
      }
    },
    "check": { "executor": "nx:noop" }
  }
}
