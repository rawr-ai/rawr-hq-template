PREFIX workbench: <urn:semantica-workbench:ontology:>
PREFIX evidence: <urn:semantica-workbench:evidence:>

SELECT ?finding ?target ?sourcePath ?lineStart ?lineEnd ?charStart ?charEnd ?rule ?reviewAction WHERE {
  ?finding a workbench:ReviewFinding ;
    workbench:partOfEvidenceIndex ?evidenceIndex ;
    workbench:resolvedTarget ?target ;
    workbench:sourcePath ?sourcePath ;
    workbench:lineStart ?lineStart ;
    workbench:lineEnd ?lineEnd ;
    workbench:charStart ?charStart ;
    workbench:charEnd ?charEnd ;
    workbench:rule ?rule .
  OPTIONAL { ?finding workbench:reviewAction ?reviewAction . }
  FILTER(CONTAINS(STR(?target), "forbidden_pattern") || CONTAINS(?rule, "prohibited"))
}
ORDER BY ?sourcePath ?lineStart
