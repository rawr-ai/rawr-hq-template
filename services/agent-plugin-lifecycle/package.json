{
  "name": "@rawr/agent-plugin-lifecycle",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "imports": {
    "#agent-plugin-lifecycle-service/*": "./src/service/*.ts"
  },
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun --bun vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@orpc/client": "2.0.0-beta.20",
    "@orpc/contract": "2.0.0-beta.20",
    "@orpc/experimental-effect": "2.0.0-beta.20",
    "@orpc/server": "2.0.0-beta.20",
    "@rawr/hq-sdk": "workspace:*",
    "@rawr/resource-agent-plugin-package-output": "workspace:*",
    "@rawr/resource-content-workspace": "workspace:*",
    "@rawr/resource-native-agent-provider": "workspace:*",
    "@rawr/resource-versioned-content": "workspace:*",
    "@rawr/typebox-adapter": "workspace:*",
    "effect": "4.0.0-beta.101",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@types/bun": "^1.2.10",
    "@types/node": "^22.14.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "nx": {
    "tags": [
      "type:service",
      "role:servicepackage",
      "migration-slice:structural-tranche"
    ]
  }
}
