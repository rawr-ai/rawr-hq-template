{
  "name": "@habitat-ai/rawr-chatgpt-corpus",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "services/chatgpt-corpus"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./orpc/ports/workspace-store": {
      "types": "./src/orpc/ports/workspace-store.ts",
      "default": "./src/orpc/ports/workspace-store.ts"
    },
    "./service/contract": {
      "types": "./src/service/contract.ts",
      "default": "./src/service/contract.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project chatgpt-corpus"
  },
  "dependencies": {
    "@orpc/contract": "2.0.0-beta.20",
    "@orpc/server": "2.0.0-beta.20",
    "@habitat-ai/rawr-hq-sdk": "workspace:*",
    "@habitat-ai/typebox-adapter": "0.1.1",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "@types/node": "^22.14.0",
    "typescript": "^5.9.3"
  },
  "nx": {
    "tags": [
      "type:service",
      "role:servicepackage"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
