{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "habitat",
  "root": "scripts/habitat",
  "projectType": "application",
  "tags": ["type:tool", "role:architecture-policy"],
  "targets": {
    "acceptance:product-separation-absence": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["@habitat-ai/cli"],
          "target": "manifest"
        }
      ],
      "outputs": [],
      "options": {
        "command": "bun test scripts/habitat/product-separation-absence.test.ts scripts/habitat/runtime-adapter-law.test.ts scripts/habitat/runtime-harness-law.test.ts scripts/habitat/runtime-observation-law.test.ts"
      }
    },
    "check:policy": {
      "parallelism": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/**/*.{js,mjs,jsx,cjs,ts,mts,cts,tsx,json,jsonld,webapp,webmanifest,jsonc,code-snippets,code-workspace,sublime-build,sublime-commands,sublime-completions,sublime-keymap,sublime-macro,sublime-menu,sublime-mousemap,sublime-project,sublime-settings,sublime-theme,sublime-workspace,sublime_metrics,sublime_session,css,graphqls,graphql,gql,html,svg,astro,vue,svelte,grit}",
        "{workspaceRoot}/**/{.all-contributorsrc,.arcconfig,.auto-changelog,.bowerrc,.c8rc,.htmlhintrc,.imgbotconfig,.jslintrc,.nycrc,.tern-config,.tern-project,.vuerc,.watchmanconfig,.ember-cli,.jscsrc,.jshintrc,.babelrc,.hintrc,.swcrc,mcmod.info}",
        "{workspaceRoot}/.editorconfig"
      ],
      "outputs": [],
      "options": {
        "command": "biome ci --diagnostic-level=error ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "biome format --write ."
      }
    },
    "lint:effect": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}",
        "{workspaceRoot}/biome.json",
        "{workspaceRoot}/biome.effect.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/patches/@catenarycloud%2Flinteffect@0.0.6.patch"
      ],
      "outputs": [],
      "options": {
        "command": "biome lint --config-path=biome.effect.json ."
      }
    },
    "check": {
      "executor": "nx:noop",
      "cache": false,
      "outputs": []
    }
  }
}
