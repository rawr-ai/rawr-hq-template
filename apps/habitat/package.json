{
  "name": "@habitat-ai/cli",
  "version": "0.4.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "apps/habitat"
  },
  "description": "Habitat structural authority CLI and Nx projection",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^24.18.1"
  },
  "files": [
    "bin",
    "dist",
    "generators.json",
    "generators.schema.json",
    "oclif.manifest.json",
    "package.json"
  ],
  "bin": {
    "habitat": "./bin/run.js"
  },
  "generators": "./generators.json",
  "exports": {
    "./nx-plugin": {
      "types": "./dist/nx-plugin.d.ts",
      "import": "./dist/nx-plugin.js",
      "default": "./dist/nx-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "habitat": "bun src/index.ts",
    "build": "tsc -p src/tsconfig.build.json",
    "manifest": "NODE_ENV=production bun --bun oclif manifest",
    "acceptance:oclif-installed-package": "vitest run --project habitat-cli-installed-package-acceptance",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run --project habitat-cli"
  },
  "dependencies": {
    "@habitat-ai/sdk": "0.4.0",
    "@nx/devkit": "23.1.0",
    "@oclif/core": "^4.13.2",
    "@oclif/plugin-help": "^6.2.27",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "bun-types": "1.3.14",
    "oclif": "4.23.29",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "oclif": {
    "bin": "habitat",
    "dirname": "habitat",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "typescript": {
      "commands": "./src/commands"
    }
  },
  "nx": {
    "tags": [
      "npm:public",
      "type:app",
      "app:habitat",
      "role:cli"
    ],
    "targets": {
      "manifest": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "build",
          "manifest"
        ]
      },
      "acceptance:oclif-installed-package": {
        "cache": false,
        "dependsOn": [
          "manifest"
        ],
        "outputs": []
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
