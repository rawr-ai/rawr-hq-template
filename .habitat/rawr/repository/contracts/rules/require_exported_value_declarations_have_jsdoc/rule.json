{
  "schemaVersion": 2,
  "id": "require_exported_value_declarations_have_jsdoc",
  "title": "Require Exported Value Declarations To Have JSDoc",
  "placement": {
    "niche": "rawr/repository/contracts",
    "blueprint": "_self",
    "category": "contract"
  },
  "operation": {
    "kind": "check"
  },
  "ownerProject": "habitat",
  "lane": "enforced",
  "forbids": "an authored RAWR runtime or tool value implementation export without adjacent nonempty declaration-site JSDoc or with an obvious placeholder JSDoc block",
  "why": "Exported values cross module boundaries. Declaration-site documentation keeps their owner, purpose, and intended semantics visible through reuse and relocation while review owns semantic quality.",
  "remediate": "Delete an unused export or add adjacent nonempty, non-placeholder JSDoc before its defining runtime declaration. Explain purpose, behavior, ownership, or invariants. Document a direct anonymous default value at its export statement; leave type-only and ambient declarations to TypeScript and re-export barrels to inherit documentation from the owner.",
  "message": "Exported authored value declarations require adjacent nonempty non-placeholder declaration-site JSDoc.",
  "pathCoverage": [
    {
      "kind": "exact-path",
      "patterns": [
        "apps/cli/src/commands/agent/plugins/**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}",
        "packages/hq-sdk/src/index.ts",
        "packages/hq-sdk/src/plugins.ts",
        "packages/hq-sdk/src/apis.ts",
        "packages/hq-sdk/src/composition.ts",
        "packages/hq-sdk/src/workflows.ts",
        "packages/hq-sdk/src/host-adapters/**/*.ts",
        "resources/agent-plugin-package-output/contract.ts",
        "resources/agent-plugin-package-output/providers/*/index.ts",
        "resources/content-workspace/contract.ts",
        "resources/content-workspace/providers/*/index.ts",
        "resources/native-agent-provider/contract.ts",
        "resources/native-agent-provider/providers/*/index.ts",
        "resources/versioned-content/contract.ts",
        "resources/versioned-content/providers/*/index.ts",
        "services/agent-plugin-lifecycle/src/client.ts"
      ]
    }
  ],
  "hookCheck": true,
  "supportFiles": {
    "baseline": ".habitat/rawr/repository/contracts/rules/require_exported_value_declarations_have_jsdoc/baseline.json"
  },
  "runner": {
    "name": "grit",
    "files": {
      "pattern": ".habitat/rawr/repository/contracts/rules/require_exported_value_declarations_have_jsdoc/pattern.md"
    },
    "patternName": "require_exported_value_declarations_have_jsdoc",
    "acquisition": {
      "kind": "check",
      "roots": [
        "apps/cli/src/commands/agent/plugins",
        "packages/hq-sdk/src/index.ts",
        "packages/hq-sdk/src/plugins.ts",
        "packages/hq-sdk/src/apis.ts",
        "packages/hq-sdk/src/composition.ts",
        "packages/hq-sdk/src/workflows.ts",
        "packages/hq-sdk/src/host-adapters",
        "resources/agent-plugin-package-output/contract.ts",
        "resources/agent-plugin-package-output/providers",
        "resources/content-workspace/contract.ts",
        "resources/content-workspace/providers",
        "resources/native-agent-provider/contract.ts",
        "resources/native-agent-provider/providers",
        "resources/versioned-content/contract.ts",
        "resources/versioned-content/providers",
        "services/agent-plugin-lifecycle/src/client.ts"
      ]
    }
  }
}
