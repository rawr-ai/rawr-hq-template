{
  "name": "@habitat/service",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "imports": {
    "#habitat-service/*": "./src/service/*.ts"
  },
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "dependencies": {
    "@orpc/contract": "2.0.0-beta.20",
    "@orpc/experimental-effect": "2.0.0-beta.20",
    "@orpc/server": "2.0.0-beta.20",
    "@rawr/typebox-adapter": "workspace:*",
    "effect": "4.0.0-beta.101",
    "smol-toml": "1.7.0",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "bun-types": "1.3.14",
    "typescript": "^5.9.3"
  },
  "nx": {
    "tags": [
      "type:service",
      "role:servicepackage"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
