{
  "name": "@habitat-ai/rawr-core",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "packages/core"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workspace-root": {
      "types": "./src/workspace-root.ts",
      "default": "./src/workspace-root.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    }
  },
  "dependencies": {
    "@oclif/core": "^4.2.10",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.6.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@orpc/opentelemetry": "2.0.0-beta.20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project core"
  },
  "nx": {
    "tags": [
      "type:package",
      "migration-slice:structural-tranche"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
