      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./service/contract": {
      "types": "./src/service/contract.ts",
      "default": "./src/service/contract.ts"
    },
    "./ports/session-source-runtime": {
      "types": "./src/service/common/ports/session-source-runtime.ts",
      "default": "./src/service/common/ports/session-source-runtime.ts"
    },
    "./ports/session-index-runtime": {
      "types": "./src/service/common/ports/session-index-runtime.ts",
      "default": "./src/service/common/ports/session-index-runtime.ts"
    },
    "./entities": {
      "types": "./src/service/common/entities.ts",
      "default": "./src/service/common/entities.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@orpc/contract": "2.0.0-beta.20",
