{
  "name": "@rawr/example-todo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.7",
  "imports": {
    "#example-todo-service/*": "./src/service/*.ts"
  },
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project example-todo"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@orpc/contract": "2.0.0-beta.23",
    "@orpc/server": "2.0.0-beta.23",
    "@habitat-ai/rawr-hq-sdk": "workspace:*",
    "@habitat-ai/typebox-adapter": "workspace:*",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "typescript": "^5.9.3"
  },
  "nx": {
    "tags": [
      "type:service",
      "role:servicepackage"
    ]
  }
}
