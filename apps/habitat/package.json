{
  "name": "@habitat-ai/cli",
  "version": "0.3.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawr-ai/rawr-hq-template.git",
    "directory": "apps/habitat"
  },
  "description": "Habitat structural authority CLI and Nx projection",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^20.19.0 || >=22.9.0"
  },
  "files": [
    "bin",
    "dist",
    "generators.json",
    "generators.schema.json",
    "src/nx-plugin.d.ts",
    "oclif.manifest.json",
    "package.json"
  ],
  "bin": {
    "habitat": "./bin/run.js"
  },
  "generators": "./generators.json",
  "exports": {
    "./nx-plugin": {
      "types": "./src/nx-plugin.d.ts",
      "import": "./dist/nx-plugin.js",
      "default": "./dist/nx-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "habitat": "bun src/index.ts",
    "build": "tsc -p src/tsconfig.build.json && bun build src/nx-plugin.ts --outdir dist --target node --format esm && bun build src/generators/init.ts --outfile dist/generators/init.cjs --target node --format cjs --packages=external && bun build src/generators/remove-hook.ts --outfile dist/generators/remove-hook.cjs --target node --format cjs --packages=external",
    "manifest": "NODE_ENV=production bun --bun oclif manifest",
    "acceptance:oclif-installed-package": "vitest run --project habitat-cli-installed-package-acceptance",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run --project habitat-cli"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@getgrit/cli": "0.1.0-alpha.1743007075",
    "@habitat-ai/plugin-cli": "0.3.1",
    "@habitat-ai/resource-rule-evaluation": "0.3.1",
    "@habitat-ai/resource-source-inventory": "0.3.1",
    "@habitat-ai/service": "0.3.1",
    "@nx/devkit": "23.1.0",
    "@oclif/core": "^4.11.4",
    "@oclif/plugin-help": "^6.2.27",
    "effect": "4.0.0-beta.101",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "bun-types": "1.3.14",
    "oclif": "4.23.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@habitat-ai/blueprints": "0.2.1"
  },
  "oclif": {
    "bin": "habitat",
    "dirname": "habitat",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@habitat-ai/plugin-cli"
    ]
  },
  "nx": {
    "tags": [
      "npm:public",
      "type:app",
      "app:habitat",
      "role:cli"
    ],
    "targets": {
      "manifest": {
        "dependsOn": [
          "build",
          {
            "projects": [
              "@habitat-ai/plugin-cli"
            ],
            "target": "manifest"
          }
        ]
      },
      "test": {
        "dependsOn": [
          "build",
          "manifest"
        ]
      },
      "acceptance:oclif-installed-package": {
        "cache": false,
        "dependsOn": [
          "manifest"
        ],
        "outputs": []
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
