{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@habitat-ai/sdk",
  "targets": {
    "build": {
      "inputs": [
        "production",
        "^production",
        "typescriptRuntime",
        "{workspaceRoot}/.habitat/blueprints/app/**/*",
        "{workspaceRoot}/.habitat/blueprints/package/**/*",
        "{workspaceRoot}/.habitat/blueprints/plugin/**/*",
        "{workspaceRoot}/.habitat/blueprints/plugin-nx/**/*",
        "{workspaceRoot}/.habitat/blueprints/provider/**/*",
        "{workspaceRoot}/.habitat/blueprints/resource/**/*",
        "{workspaceRoot}/.habitat/blueprints/runtime-bootgraph/**/*",
        "{workspaceRoot}/.habitat/blueprints/runtime-compiler/**/*",
        "{workspaceRoot}/.habitat/blueprints/runtime-definition/**/*",
        "{workspaceRoot}/.habitat/blueprints/runtime-derivation/**/*",
        "{workspaceRoot}/.habitat/blueprints/service/**/*"
      ]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
